# Producción (Neon + Render):
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Local SQLite (recomendado sin Docker):
USE_SQLITE=1
SQLITE_PATH=sabores_local.db

# Local MySQL (docker-compose):
# MYSQL_HOST=db
# MYSQL_USER=root
# MYSQL_PASSWORD=1234
# MYSQL_DB=recipesSpain
# MYSQL_PORT=3306

JWT_SECRET_KEY=cambia-este-secreto-largo-y-aleatorio-min-32-chars
JWT_ACCESS_HOURS=12
FLASK_ENV=development

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
# Producción:
# CORS_ORIGINS=https://sabores-espana-one.vercel.app
# FLASK_ENV=production

# Media en la nube (obligatorio en Render para no perder ficheros):
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# o bien:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=300
